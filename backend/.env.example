# Sao chép thành backend/.env rồi sửa đúng máy SQL Server của bạn.
PORT=5000
HOST=127.0.0.1
DB_SERVER=localhost
# DB_SERVER=NHUY\MSSQLSERVER01 cũng được. Với named instance, để trống DB_PORT.
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=DIEN_MAT_KHAU_SQL_SERVER
DB_DATABASE=CoffeeChainCafeV4
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECT_TIMEOUT=5000
# Chỉ bật true khi phục vụ qua HTTPS.
COOKIE_SECURE=false


# Giới hạn phân ca của ứng dụng (giờ).
SCHEDULE_MAX_SHIFT_HOURS=12
SCHEDULE_MAX_DAY_HOURS=12
SCHEDULE_MAX_WEEK_HOURS=48
